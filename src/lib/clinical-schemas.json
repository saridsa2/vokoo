                  "code"
                ],
                "properties": {
                  "system": {
                    "type": "string",
                    "format": "uri"
                  },
                  "code": {
                    "type": "string"
                  },
                  "display": {
                    "type": "string"
                  }
                }
              },
              "minItems": 1
            },
            "text": {
              "type": "string"
            }
          },
          "description": "Clinical indication for the medication."
        },
        "instructions": {
          "type": "string"
        }
      }
    }
  },
  "family-health": {
    "source": "urn:vokoo:clinical:schema:family-health:v0.1.0",
    "title": "VoKoo Family Health Tree",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vokoo:clinical:schema:family-health:v0.1.0",
      "title": "VoKoo Family Health Tree",
      "description": "Family health tree recording relationships and potentially inherited conditions.",
      "type": "object",
      "required": [
        "probandId",
        "members"
      ],
      "properties": {
        "probandId": {
          "type": "string",
          "description": "Identifier of the proband, the person at the centre of the family history."
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "relationToProband"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "relationToProband": {
                "type": "string",
                "enum": [
                  "self",
                  "mother",
                  "father",
                  "sibling",
                  "child",
                  "grandparent",
                  "grandchild",
                  "aunt",
                  "uncle",
                  "cousin",
                  "other"
                ],
                "description": "Relationship to the proband, mappable to an HL7 v3 RoleCode."
              },
              "sex": {
                "type": "string",
                "enum": [
                  "male",
                  "female",
                  "other",
                  "unknown"
                ]
              },
              "birthYear": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "deceased": {
                "type": "boolean"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "coding"
                  ],
                  "properties": {
                    "coding": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "system",
                          "code"
                        ],
                        "properties": {
                          "system": {
                            "type": "string",
                            "format": "uri"
                          },
                          "code": {
                            "type": "string"
                          },
                          "display": {
                            "type": "string"
                          }
                        }
                      },
                      "minItems": 1
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                },
                "description": "Significant inherited or chronic conditions, preferably coded with SNOMED CT or ICD-10."
              }
            }
          }
        }
      }
    }
  }
