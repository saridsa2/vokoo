{
  "health": {
    "source": "urn:vokoo:clinical:schema:health:v0.1.0",
    "title": "VoKoo Health Core",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vokoo:clinical:schema:health:v0.1.0",
      "title": "VoKoo Health Core",
      "description": "Core personal health record using a minimal practical subset of the HL7 FHIR Patient resource.",
      "type": "object",
      "required": [
        "id",
        "name",
        "birthDate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Globally unique UUID or ULID."
        },
        "resourceType": {
          "type": "string",
          "const": "Person",
          "description": "Resource type, always Person."
        },
        "identifier": {
          "type": "array",
          "description": "External identifiers such as a medical record number or national identifier.",
          "items": {
            "type": "object",
            "required": [
              "system",
              "value"
            ],
            "properties": {
              "system": {
                "type": "string",
                "format": "uri"
              },
              "value": {
                "type": "string"
              },
              "type": {
                "type": "object",
                "required": [
                  "coding"
                ],
                "properties": {
                  "coding": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "system",
                        "code"
                      ],
                      "properties": {
                        "system": {
                          "type": "string",
                          "format": "uri"
                        },
                        "code": {
                          "type": "string"
                        },
                        "display": {
                          "type": "string"
                        }
                      }
                    },
                    "minItems": 1
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              "period": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "name": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "family",
              "given"
            ],
            "properties": {
              "use": {
                "type": "string",
                "enum": [
                  "official",
                  "usual",
                  "nickname",
                  "anonymous",
                  "old",
                  "maiden"
                ]
              },
              "family": {
                "type": "string"
              },
              "given": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "prefix": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "suffix": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Names for the person, with at least one entry."
        },
        "birthDate": {
          "type": "string",
          "format": "date",
          "description": "Date of birth in ISO 8601 format."
        },
        "gender": {
          "type": "string",
          "enum": [
            "male",
            "female",
            "other",
            "unknown"
          ],
          "description": "Administrative gender using the FHIR value set."
        },
        "telecom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "system",
              "value"
            ],
            "properties": {
              "system": {
                "type": "string",
                "enum": [
                  "phone",
                  "email"
                ]
              },
              "value": {
                "type": "string"
              },
              "use": {
                "type": "string",
                "enum": [
                  "home",
                  "work",
                  "mobile"
                ]
              }
            }
          },
          "description": "Contact details such as telephone numbers and email addresses."
        },
        "address": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "postalCode": {
                "type": "string"
              },
              "country": {
                "type": "string"
              }
            }
          },
          "description": "Postal addresses for the person."
        },
        "maritalStatus": {
          "type": "object",
          "required": [
            "coding"
          ],
          "properties": {
            "coding": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "system",
                  "code"
                ],
                "properties": {
                  "system": {
                    "type": "string",
                    "format": "uri"
                  },
                  "code": {
                    "type": "string"
                  },
                  "display": {
                    "type": "string"
                  }
                }
              },
              "minItems": 1
            },
            "text": {
              "type": "string"
            }
          },
          "description": "Marital status, optionally coded with the HL7 v3 MaritalStatus value set."
        },
        "language": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Preferred languages expressed as IETF BCP 47 language tags."
        },
        "clinicalSummary": {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "coding"
                ],
                "properties": {
                  "coding": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "system",
                        "code"
                      ],
                      "properties": {
                        "system": {
                          "type": "string",
                          "format": "uri"
                        },
                        "code": {
                          "type": "string"
                        },
                        "display": {
                          "type": "string"
                        }
                      }
                    },
                    "minItems": 1
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              "description": "Known conditions and diagnoses, preferably coded with SNOMED CT or ICD-10."
            },
            "allergies": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "coding"
                ],
                "properties": {
                  "coding": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "system",
                        "code"
                      ],
                      "properties": {
                        "system": {
                          "type": "string",
                          "format": "uri"
                        },
                        "code": {
                          "type": "string"
                        },
                        "display": {
                          "type": "string"
                        }
                      }
                    },
                    "minItems": 1
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              "description": "Known allergies."
            },
            "bloodType": {
              "type": "string",
              "description": "Blood group, such as A+ or O-."
            },
            "primaryCareProvider": {
              "type": "string",
              "description": "Identifier of the person's primary clinician or care organization."
            }
          }
        }
      }
    }
  },
  "lab-report": {
    "source": "urn:vokoo:clinical:schema:lab-report:v0.1.0",
    "title": "VoKoo Lab Report",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vokoo:clinical:schema:lab-report:v0.1.0",
      "title": "VoKoo Lab Report",
      "description": "Structured laboratory report using LOINC for test codes and UCUM for units.",
      "type": "object",
      "required": [
        "id",
        "patientId",
        "issuedAt",
        "results"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patientId": {
          "type": "string",
          "description": "Person.id of the associated health record."
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "facility": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "panel": {
          "type": "object",
          "required": [
            "coding"
          ],
          "properties": {
            "coding": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "system",
                  "code"
                ],
                "properties": {
                  "system": {
                    "type": "string",
                    "format": "uri"
                  },
                  "code": {
                    "type": "string"
                  },
                  "display": {
                    "type": "string"
                  }
                }
              },
              "minItems": 1
            },
            "text": {
              "type": "string"
            }
          }
        },
        "specimen": {
          "type": "object",
          "properties": {
            "type": {
              "type": "object",
              "required": [
                "system",
                "code"
              ],
              "properties": {
                "system": {
                  "type": "string",
                  "format": "uri"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "BLD",
                    "SER",
                    "PLAS",
                    "UR"
                  ],
                  "description": "Common specimen types: whole blood, serum, plasma, and urine."
                },
                "display": {
                  "type": "string"
                }
              }
            },
            "collectedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "value"
            ],
            "properties": {
              "code": {
                "type": "object",
                "required": [
                  "coding"
                ],
                "properties": {
                  "coding": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "system",
                        "code"
                      ],
                      "properties": {
                        "system": {
                          "type": "string",
                          "format": "uri"
                        },
                        "code": {
                          "type": "string"
                        },
                        "display": {
                          "type": "string"
                        }
                      }
                    },
                    "minItems": 1
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "description": "LOINC code identifying the laboratory test."
              },
              "value": {
                "description": "Laboratory result as a numeric quantity, qualitative string, or coded concept.",
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "value",
                      "unit"
                    ],
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "mg",
                              "g",
                              "g/L",
                              "g/dL",
                              "mg/dL",
                              "mg/L",
                              "mmol/L",
                              "nmol/L",
                              "umol/L",
                              "pmol/L",
                              "ng/mL",
                              "ng/dL",
                              "ng/L",
                              "ug/dL",
                              "pg/mL",
                              "%",
                              "U/L",
                              "U/mL",
                              "IU/L",
                              "IU/mL",
                              "kU/L",
                              "k[IU]/L",
                              "mU/L",
                              "mIU/L",
                              "m[IU]/L",
                              "mIU/mL",
                              "m[IU]/mL",
                              "uIU/mL",
                              "10*3/uL",
                              "10*6/uL",
                              "10*9/L",
                              "10*12/L",
                              "cells/uL",
                              "mEq/L",
                              "mmHg",
                              "mm/h",
                              "mL",
                              "uL",
                              "L",
                              "kat/L",
                              "mmol/mol",
                              "{titer}"
                            ],
                            "description": "Strict subset of common UCUM units covering blood counts, biochemistry, immunology, and tumour-marker tests."
                          },
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9%\\[\\]{}().*/^+-]+$",
                            "description": "Validates common UCUM-style unit characters and disallows spaces."
                          }
                        ],
                        "description": "UCUM unit using the permissive default pattern. Use UCUMUnitStrict when a restricted unit set is required."
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "coding"
                    ],
                    "properties": {
                      "coding": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "system",
                            "code"
                          ],
                          "properties": {
                            "system": {
                              "type": "string",
                              "format": "uri"
                            },
                            "code": {
                              "type": "string"
                            },
                            "display": {
                              "type": "string"
                            }
                          }
                        },
                        "minItems": 1
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "referenceRange": {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "object",
                    "required": [
                      "value",
                      "unit"
                    ],
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "mg",
                              "g",
                              "g/L",
                              "g/dL",
                              "mg/dL",
                              "mg/L",
                              "mmol/L",
                              "nmol/L",
                              "umol/L",
                              "pmol/L",
                              "ng/mL",
                              "ng/dL",
                              "ng/L",
                              "ug/dL",
                              "pg/mL",
                              "%",
                              "U/L",
                              "U/mL",
                              "IU/L",
                              "IU/mL",
                              "kU/L",
                              "k[IU]/L",
                              "mU/L",
                              "mIU/L",
                              "m[IU]/L",
                              "mIU/mL",
                              "m[IU]/mL",
                              "uIU/mL",
                              "10*3/uL",
                              "10*6/uL",
                              "10*9/L",
                              "10*12/L",
                              "cells/uL",
                              "mEq/L",
                              "mmHg",
                              "mm/h",
                              "mL",
                              "uL",
                              "L",
                              "kat/L",
                              "mmol/mol",
                              "{titer}"
                            ],
                            "description": "Strict subset of common UCUM units covering blood counts, biochemistry, immunology, and tumour-marker tests."
                          },
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9%\\[\\]{}().*/^+-]+$",
                            "description": "Validates common UCUM-style unit characters and disallows spaces."
                          }
                        ],
                        "description": "UCUM unit using the permissive default pattern. Use UCUMUnitStrict when a restricted unit set is required."
                      }
                    }
                  },
                  "high": {
                    "type": "object",
                    "required": [
                      "value",
                      "unit"
                    ],
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "mg",
                              "g",
                              "g/L",
                              "g/dL",
                              "mg/dL",
                              "mg/L",
                              "mmol/L",
                              "nmol/L",
                              "umol/L",
                              "pmol/L",
                              "ng/mL",
                              "ng/dL",
                              "ng/L",
                              "ug/dL",
                              "pg/mL",
                              "%",
                              "U/L",
                              "U/mL",
                              "IU/L",
                              "IU/mL",
                              "kU/L",
                              "k[IU]/L",
                              "mU/L",
                              "mIU/L",
                              "m[IU]/L",
                              "mIU/mL",
                              "m[IU]/mL",
                              "uIU/mL",
                              "10*3/uL",
                              "10*6/uL",
                              "10*9/L",
                              "10*12/L",
                              "cells/uL",
                              "mEq/L",
                              "mmHg",
                              "mm/h",
                              "mL",
                              "uL",
                              "L",
                              "kat/L",
                              "mmol/mol",
                              "{titer}"
                            ],
                            "description": "Strict subset of common UCUM units covering blood counts, biochemistry, immunology, and tumour-marker tests."
                          },
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9%\\[\\]{}().*/^+-]+$",
                            "description": "Validates common UCUM-style unit characters and disallows spaces."
                          }
                        ],
                        "description": "UCUM unit using the permissive default pattern. Use UCUMUnitStrict when a restricted unit set is required."
                      }
                    }
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              "interpretation": {
                "type": "string",
                "enum": [
                  "N",
                  "L",
                  "H",
                  "A"
                ],
                "description": "Interpretation: N normal, L low, H high, or A abnormal."
              },
              "method": {
                "type": "object",
                "required": [
                  "coding"
                ],
                "properties": {
                  "coding": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "system",
                        "code"
                      ],
                      "properties": {
                        "system": {
                          "type": "string",
                          "format": "uri"
                        },
                        "code": {
                          "type": "string"
                        },
                        "display": {
                          "type": "string"
                        }
                      }
                    },
                    "minItems": 1
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "imaging-report": {
    "source": "urn:vokoo:clinical:schema:imaging-report:v0.1.0",
    "title": "VoKoo Imaging Report",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vokoo:clinical:schema:imaging-report:v0.1.0",
      "title": "VoKoo Imaging Report",
      "description": "Structured imaging report using DICOM modality codes and SNOMED CT body-site codes.",
      "type": "object",
      "required": [
        "id",
        "patientId",
        "modality",
        "bodySite",
        "reportedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patientId": {
          "type": "string"
        },
        "studyInstanceUid": {
          "type": "string",
          "description": "DICOM Study Instance UID."
        },
        "modality": {
          "type": "object",
          "required": [
            "system",
            "code"
          ],
          "properties": {
            "system": {
              "type": "string",
              "format": "uri"
            },
            "code": {
              "type": "string",
              "enum": [
                "CT",
                "MR",
                "US",
                "XR",
                "PT"
              ],
              "description": "Common imaging modalities: CT, MR, ultrasound, radiography, and PET."
            },
            "display": {
              "type": "string"
            }
          }
        },
        "bodySite": {
          "type": "object",
          "required": [
            "system",
            "code"
          ],
          "properties": {
            "system": {
              "type": "string",
              "format": "uri"
            },
            "code": {
              "type": "string"
            },
            "display": {
              "type": "string"
            }
          },
          "description": "Examined body site, preferably coded with a SNOMED CT anatomical structure code."
        },
        "reportedAt": {
          "type": "string",
          "format": "date-time"
        },
        "performer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Imaging findings."
        },
        "impression": {
          "type": "string",
          "description": "Diagnostic conclusion or impression."
        },
        "radiationDose": {
          "type": "object",
          "properties": {
            "ctdiVol_mGy": {
              "type": "number",
              "description": "Computed tomography dose index by volume, in mGy."
            },
            "dlp_mGy_cm": {
              "type": "number",
              "description": "Dose-length product, in mGy cm."
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "type": {
                "type": "string",
                "description": "Attachment type, such as a thumbnail or report PDF."
              }
            }
          }
        }
      }
    }
  },
  "medication": {
    "source": "urn:vokoo:clinical:schema:medication:v0.1.0",
    "title": "VoKoo Medication Record",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vokoo:clinical:schema:medication:v0.1.0",
      "title": "VoKoo Medication Record",
      "description": "Medication record using RxNorm drug codes and common administration routes.",
      "type": "object",
      "required": [
        "id",
        "patientId",
        "medication",
        "dosage",
        "route",
        "startDate"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patientId": {
          "type": "string"
        },
        "medication": {
          "type": "object",
          "required": [
            "system",
            "code"
          ],
          "properties": {
            "system": {
              "type": "string",
              "format": "uri"
            },
            "code": {
              "type": "string"
            },
            "display": {
              "type": "string"
            }
          },
          "description": "Medication code, preferably from RxNorm."
        },
        "form": {
          "type": "object",
          "required": [
            "system",
            "code"
          ],
          "properties": {
            "system": {
              "type": "string",
              "format": "uri"
            },
            "code": {
              "type": "string"
            },
            "display": {
              "type": "string"
            }
          },
          "description": "Dose form, such as tablet or capsule."
        },
        "route": {
          "type": "object",
          "required": [
            "system",
            "code"
          ],
          "properties": {
            "system": {
              "type": "string",
              "format": "uri"
            },
            "code": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "PO",
                    "IV",
                    "IM",
                    "SC",
                    "INH",
                    "SL",
                    "PR"
                  ],
                  "description": "Common route abbreviations."
                },
                {
                  "type": "string",
                  "enum": [
                    "26643006",
                    "47625008",
                    "78421000",
                    "34206005",
                    "447694001",
                    "37839007",
                    "37161004"
                  ],
                  "description": "SNOMED CT route codes for oral, intravenous, intramuscular, subcutaneous, inhaled, sublingual, and rectal administration."
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{3,18}$"
                }
              ]
            },
            "display": {
              "type": "string"
            }
          },
          "description": "Administration route, such as oral (PO) or intravenous (IV)."
        },
        "dosage": {
          "type": "object",
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "description": "UCUM unit, such as mg or mL."
            }
          }
        },
        "frequency": {
          "type": "string",
          "description": "Administration frequency, such as QD, BID, or TID."
        },
        "durationDays": {
          "type": "integer",
          "minimum": 1
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "indication": {
          "type": "object",
          "required": [
            "coding"
          ],
          "properties": {
