{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:vokoo:clinical:schema:medication:v0.1.0",
    "title": "VoKoo Medication Record",
    "description": "Medication record using RxNorm drug codes and common administration routes.",
    "type": "object",
    "required": ["id", "patientId", "medication", "dosage", "route", "startDate"],
    "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "medication": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/Coding", "description": "Medication code, preferably from RxNorm." },
        "form": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/Coding", "description": "Dose form, such as tablet or capsule." },
        "route": {
            "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/Route",
            "description": "Administration route, such as oral (PO) or intravenous (IV)."
        },
        "dosage": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
                "value": { "type": "number" },
                "unit": { "type": "string", "description": "UCUM unit, such as mg or mL." }
            }
        },
        "frequency": { "type": "string", "description": "Administration frequency, such as QD, BID, or TID." },
        "durationDays": { "type": "integer", "minimum": 1 },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "indication": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept", "description": "Clinical indication for the medication." },
        "instructions": { "type": "string" }
    }
}
