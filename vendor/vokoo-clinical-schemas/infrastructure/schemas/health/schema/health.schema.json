{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:vokoo:clinical:schema:health:v0.1.0",
    "title": "VoKoo Health Core",
    "description": "Core personal health record using a minimal practical subset of the HL7 FHIR Patient resource.",
    "type": "object",
    "required": ["id", "name", "birthDate"],
    "properties": {
        "id": {
            "type": "string",
            "description": "Globally unique UUID or ULID."
        },
        "resourceType": {
            "type": "string",
            "const": "Person",
            "description": "Resource type, always Person."
        },
        "identifier": {
            "type": "array",
            "description": "External identifiers such as a medical record number or national identifier.",
            "items": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/Identifier" }
        },
        "name": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/HumanName" },
            "description": "Names for the person, with at least one entry."
        },
        "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Date of birth in ISO 8601 format."
        },
        "gender": {
            "type": "string",
            "enum": ["male", "female", "other", "unknown"],
            "description": "Administrative gender using the FHIR value set."
        },
        "telecom": {
            "type": "array",
            "items": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/ContactPoint" },
            "description": "Contact details such as telephone numbers and email addresses."
        },
        "address": {
            "type": "array",
            "items": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/Address" },
            "description": "Postal addresses for the person."
        },
        "maritalStatus": {
            "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept",
            "description": "Marital status, optionally coded with the HL7 v3 MaritalStatus value set."
        },
        "language": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Preferred languages expressed as IETF BCP 47 language tags."
        },
        "clinicalSummary": {
            "type": "object",
            "properties": {
                "conditions": {
                    "type": "array",
                    "items": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept" },
                    "description": "Known conditions and diagnoses, preferably coded with SNOMED CT or ICD-10."
                },
                "allergies": {
                    "type": "array",
                    "items": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept" },
                    "description": "Known allergies."
                },
                "bloodType": {
                    "type": "string",
                    "description": "Blood group, such as A+ or O-."
                },
                "primaryCareProvider": {
                    "type": "string",
                    "description": "Identifier of the person's primary clinician or care organization."
                }
            }
        }
    },
    "$defs": {}
}
