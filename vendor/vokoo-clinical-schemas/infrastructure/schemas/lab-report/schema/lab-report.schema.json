{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:vokoo:clinical:schema:lab-report:v0.1.0",
    "title": "VoKoo Lab Report",
    "description": "Structured laboratory report using LOINC for test codes and UCUM for units.",
    "type": "object",
    "required": ["id", "patientId", "issuedAt", "results"],
    "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string", "description": "Person.id of the associated health record." },
        "issuedAt": { "type": "string", "format": "date-time" },
        "facility": {
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" }
            }
        },
        "panel": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept" },
        "specimen": {
            "type": "object",
            "properties": {
                "type": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/SpecimenType" },
                "collectedAt": { "type": "string", "format": "date-time" }
            }
        },
        "results": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/LabResult" }
        }
    },
    "$defs": {
        "LabResult": {
            "type": "object",
            "required": ["code", "value"],
            "properties": {
                "code": {
                    "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept",
                    "description": "LOINC code identifying the laboratory test."
                },
                "value": {
                    "description": "Laboratory result as a numeric quantity, qualitative string, or coded concept.",
                    "oneOf": [
                        { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/Quantity" },
                        { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept" },
                        { "type": "string", "minLength": 1 }
                    ]
                },
                "referenceRange": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/ReferenceRange" },
                "interpretation": {
                    "type": "string",
                    "enum": ["N", "L", "H", "A"],
                    "description": "Interpretation: N normal, L low, H high, or A abnormal."
                },
                "method": { "$ref": "urn:vokoo:clinical:schema:common:v0.1.0#/$defs/CodeableConcept" }
            }
        }
    }
}
