        "provider_action": "Hold",
        "default_timeout_seconds": null
    },
    {
        "id": "kookoo.hangup",
        "label": "Hang up",
        "fields": [
            {
                "key": "reason",
                "hint": "booked, transferred, abandoned",
                "type": "text",
                "label": "Reason",
                "required": true
            }
        ],
        "outcomes": [
        ],
