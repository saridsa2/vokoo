    {
        "id": "kookoo.release",
        "label": "Step back",
        "fields": [
            {
                "help": "Recorded on the call as ended_reason.",
                "name": "reason",
                "type": "string",
                "label": "Why",
                "required": false
            }
        ],
        "outcomes": [
            {
                "id": "__end__",
                "label": "Done"
            }
        ],
        "suspends": false,
        "node_type": "custom",
        "sort_order": 11,
        "description": "Ends the flow without hanging up. Use after handing the call over, when the carrier is connecting the caller to somebody else.",
        "provider_action": null,
        "default_timeout_seconds": null
    },
    {
        "id": "agent.monitor",
        "label": "Listen in",
        "fields": [
            {
                "help": "Recorded on the call as ended_reason.",
                "name": "reason",
                "type": "string",
                "label": "Why",
                "required": false
            }
        ],
        "outcomes": [
            {
                "id": "call_ended",
                "label": "Call ended"
            },
            {
                "id": "failed",
