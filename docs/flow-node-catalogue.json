                "label": "Agent",
                "required": true
            }
        ],
        "outcomes": [
            {
                "id": "done",
                "label": "Finished"
            },
            {
                "id": "out_of_scope",
                "label": "Not one of its skills"
            },
            {
                "id": "wants_human",
                "label": "Asked for a person"
            },
            {
                "id": "failed",
                "label": "Something went wrong"
            },
            {
                "id": "gone_quiet",
                "label": "Caller went quiet"
            },
            {
                "id": "timeout",
                "label": "Ran too long"
            }
        ],
        "suspends": true,
        "node_type": "custom",
        "sort_order": 5,
        "description": "Hands the conversation to an agent. It finishes as one of its outcomes and the flow continues from there. The agent never transfers anyone — it reports what happened and the flow decides what that means.",
        "provider_action": null,
        "default_timeout_seconds": 600
    },
    {
        "id": "kookoo.conference",
        "label": "Bring in a person",
        "fields": [
            {
                "key": "phoneno",
                "type": "phone",
                "label": "Number to dial",
                "required": true
            },
            {
                "key": "play_ring",
                "type": "boolean",
                "label": "Play ringing to the caller"
            }
        ],
        "outcomes": [
            {
                "id": "ok",
                "label": "They joined"
            },
            {
                "id": "failed",
                "label": "No answer"
            },
            {
                "id": "timeout",
                "label": "Rang out"
            }
        ],
        "suspends": true,
        "node_type": "custom",
        "sort_order": 6,
        "description": "Dials someone and puts them into the call. The agent can stay on the line and hand over, rather than the caller being dropped into a cold transfer.",
        "provider_action": "Conference",
        "default_timeout_seconds": 45
    },
    {
        "id": "kookoo.transfer",
        "label": "Hand the call over",
        "fields": [
            {
                "help": "Passed to the carrier exactly as written.",
                "name": "phoneno",
                "type": "string",
                "label": "Number to dial",
                "required": true
            },
            {
                "name": "record",
                "type": "boolean",
                "label": "Record the call",
                "default": true,
                "required": false
            },
            {
                "help": "Spoken to the caller when the transfer rings out, before hanging up.",
                "name": "no_answer_message",
                "type": "text",
                "label": "If nobody answers",
                "required": false
            }
        ],
        "outcomes": [
            {
                "id": "ok",
                "label": "Handed over"
            },
            {
                "id": "failed",
                "label": "No number to dial"
            }
        ],
        "suspends": false,
        "node_type": "custom",
        "sort_order": 7,
        "description": "Ends the conversation and connects the caller to another number. The agent leaves the call, so it cannot listen in afterwards — use \"Bring in a person\" if the agent should stay on the line.",
        "provider_action": null,
        "default_timeout_seconds": 30
    },
    {
        "id": "kookoo.hold",
        "label": "Hold",
        "fields": [
        ],
        "outcomes": [
