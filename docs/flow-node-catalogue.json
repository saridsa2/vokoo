[
    {
        "id": "condition",
        "label": "Condition",
        "fields": [
            {
                "key": "expression",
                "type": "expression",
                "label": "Test",
                "required": true
            }
        ],
        "outcomes": [
            {
                "id": "true",
                "label": "True"
            },
            {
                "id": "false",
                "label": "False"
            }
        ],
        "suspends": false,
        "node_type": "condition",
        "sort_order": 0,
        "description": "Chooses a path by testing the flow's variables. More than two ways out is normal — a call routes by language or department far more often than by yes and no.",
        "provider_action": null,
        "default_timeout_seconds": null
    },
    {
        "id": "loop",
        "label": "Loop",
        "fields": [
            {
                "key": "while",
                "type": "expression",
                "label": "Repeat while",
                "required": true
            },
            {
                "key": "max_iterations",
                "type": "number",
                "label": "At most",
                "required": true
            },
            {
                "key": "max_seconds",
                "hint": "seconds",
                "type": "number",
                "label": "For no longer than",
                "required": true
            }
        ],
        "outcomes": [
            {
                "id": "each",
                "label": "Each pass"
            },
            {
                "id": "done",
                "label": "Finished"
            },
            {
                "id": "exhausted",
                "label": "Ran out"
            }
        ],
        "suspends": false,
        "node_type": "loop",
        "sort_order": 1,
        "description": "Repeats until a test holds or a bound is reached. Both bounds are required: on a live call an extra pass is dead air, and the caller hangs up.",
        "provider_action": null,
        "default_timeout_seconds": null
    },
    {
        "id": "var",
