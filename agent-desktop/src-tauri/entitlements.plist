<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The webview asks for the microphone through getUserMedia. Without this
       entitlement macOS refuses it, and the refusal arrives as a rejected
       promise with no prompt shown — so an agent presses Answer and hears
       nothing, with no error to look at. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- WebRTC needs to reach Asterisk and the STUN/TURN candidates it offers. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
