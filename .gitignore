# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — never committed. .env.local currently holds only NEXT_PUBLIC_*
# values, but the file is the wrong place to rely on that staying true.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
/tmp/
*.log

# VAPI reference screenshots — 242MB of local design reference, not source.
docs/vapi-screens/*.png

# Rust build output. 844MB, regenerated by `cargo build`, and it would dwarf
# every other thing in this repository.
server/target/
bridge/target/

# A copied Sarvam site, kept locally as a reference for their icon-highlight
# pattern (a two-colour `icon-*-active.svg` per destination). 12MB of somebody
# else's build output, and it already broke `npm run build` once by putting
# unresolved imports into the TypeScript program — see tsconfig `exclude`.
indus.sarvam.ai/

# The React Bits Shader Template, kept as a reference while the marketing
# site is lifted out of it. It carries its own .git and is somebody else's
# template — the parts we use live in src/, not here.
HOMEPAGE_REF/
