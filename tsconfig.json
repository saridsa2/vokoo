{
    "compilerOptions": {
        "target": "ES2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "next-env.d.ts",
        "next.config.mjs",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": [
        // The vendored Rust crate ships TypeScript examples with their own
        // dependencies. Left in the program they put unresolved imports in the
        // type check, which `npm run build` runs — the same way a copied site
        // dump under `indus.sarvam.ai/` broke it once already.
        "bridge/vendor",
        "node_modules",
        "supabase/functions",
        "packages",
        "examples",
        "indus.sarvam.ai"
    ]
}
